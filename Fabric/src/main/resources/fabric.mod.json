{
  "schemaVersion": 1,
  "id": "dialog_quest_and_story_engine",
  "version": "${version}",
  "name": "Dialog, Quest and Story Engine",
  "description": "A lightweight framework for in-world dialogue, quests and story devices that you can attach to any entity or block. Designed for modpacks, adventure maps and RPG servers.",
  "authors": [
    "Markus Bordihn"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/dialog-quest-and-story-engine",
    "issues": "https://github.com/MarkusBordihn/BOs-Dialog-Quest-and-Story-Engine"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.markusbordihn.dialogqueststoryengine.DialogQuestStoryEngine"
    ],
    "client": [
      "de.markusbordihn.dialogqueststoryengine.DialogQuestStoryEngineClient"
    ],
    "fabric-gametest": [
      "de.markusbordihn.dialogqueststoryengine.gametest.SmokeTest",
      "de.markusbordihn.dialogqueststoryengine.gametest.BlockUuidGameTest",
      "de.markusbordihn.dialogqueststoryengine.gametest.ConditionEvaluationGameTest",
      "de.markusbordihn.dialogqueststoryengine.gametest.InteractionStoreGameTest",
      "de.markusbordihn.dialogqueststoryengine.gametest.PlayerStateGameTest",
      "de.markusbordihn.dialogqueststoryengine.gametest.QuestStepTrackerGameTest",
      "de.markusbordihn.dialogqueststoryengine.gametest.QuestWorkflowGameTest",
      "de.markusbordihn.dialogqueststoryengine.gametest.ServerRegistrationGameTest",
      "de.markusbordihn.dialogqueststoryengine.gametest.DialogWorkflowGameTest"
    ]
  },
  "mixins": [
    "dialogqueststoryengine.mixins.json"
  ],
  "accessWidener": "dialogqueststoryengine.accesswidener",
  "depends": {
    "fabricloader": ">=0.15",
    "fabric": "*",
    "minecraft": "1.20.1",
    "java": ">=17"
  },
  "suggests": {
    "tooltipfix": "*"
  }
}
