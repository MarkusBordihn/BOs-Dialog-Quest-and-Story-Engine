{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dqse://schemas/interactive_story",
  "title": "DQSE Interactive Story Definition",
  "type": "object",
  "required": ["schema", "id", "type"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"type": "integer", "const": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "ResourceLocation ID, e.g. 'mymod:the_great_journey'"
    },
    "type": {"type": "string", "const": "interactive_story"},
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title_key": {"type": "string"},
        "description_key": {"type": "string"}
      }
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "ResourceLocation reference to a theme definition"
    },
    "entry_point": {"type": "string"},
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter_id"],
        "properties": {
          "chapter_id": {"type": "string"},
          "entries": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"}
          }
        }
      }
    }
  }
}
