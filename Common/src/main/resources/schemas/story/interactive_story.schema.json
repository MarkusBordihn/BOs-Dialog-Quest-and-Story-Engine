{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dqse://schemas/interactive_story",
  "title": "DQSE Interactive Story Definition",
  "type": "object",
  "required": ["schema", "display_story_id"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"type": "integer", "const": 1},
    "narrative": {"$ref": "#/definitions/narrative"},
    "display_story_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "ResourceLocation of the StoryEntry rendered for this interactive story"
    },
    "on_open": {"type": "array", "items": {"type": "object"}},
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label_key"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "label_key": {"type": "string"},
          "conditions": {"type": "array", "items": {"type": "object"}},
          "actions": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  },
  "definitions": {
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arc": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
        "arc_key": {"type": "string"},
        "arc_order": {"type": "integer"},
        "chapter": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
        "chapter_key": {"type": "string"},
        "chapter_order": {"type": "integer"}
      }
    }
  }
}
