{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dqse://schemas/story_entry",
  "title": "DQSE Story Entry Definition",
  "type": "object",
  "required": ["schema", "type", "title_key", "theme", "pages"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"type": "integer", "const": 1},
    "type": {"type": "string"},
    "title_key": {"type": "string"},
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "ResourceLocation reference to a theme definition"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text_key"],
        "additionalProperties": false,
        "properties": {
          "text_key": {"type": "string"}
        }
      }
    }
  }
}
