{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dqse://schemas/dialog",
  "title": "DQSE Dialog Definition",
  "type": "object",
  "required": ["schema", "start_node", "nodes"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"type": "integer", "const": 1},
    "narrative": {"$ref": "#/definitions/narrative"},
    "start_node": {"type": "string"},
    "nodes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/node"}
    }
  },
  "definitions": {
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arc": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
        "arc_key": {"type": "string"},
        "arc_order": {"type": "integer"},
        "chapter": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
        "chapter_key": {"type": "string"},
        "chapter_order": {"type": "integer"}
      }
    },
    "node": {
      "type": "object",
      "required": ["speaker_key", "text_key"],
      "additionalProperties": false,
      "properties": {
        "speaker_key": {"type": "string"},
        "text_key": {"type": "string"},
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "portrait": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
            "scene": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
            "mood": {
              "type": "string", "enum": ["neutral", "happy", "sad", "angry", "surprised", "afraid"]
            },
            "theme": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"}
          }
        },
        "choices": {
          "type": "array",
          "items": {"$ref": "#/definitions/choice"}
        }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "label_key"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
        "label_key": {"type": "string"},
        "conditions": {"type": "array", "items": {"type": "object"}},
        "actions": {"type": "array", "items": {"type": "object"}},
        "next": {"type": "string"},
        "close": {"type": "boolean", "default": false},
        "once": {"type": "boolean", "default": false}
      }
    }
  }
}
