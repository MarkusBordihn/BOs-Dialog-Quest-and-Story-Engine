{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dqse://schemas/dialog",
  "title": "DQSE Dialog Definition",
  "type": "object",
  "required": ["schema", "id", "type"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "ResourceLocation ID, e.g. 'mymod:npc/greeting'"
    },
    "type": { "type": "string", "const": "dialog" },
    "entry_node": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "text_key"],
        "additionalProperties": true,
        "properties": {
          "node_id": { "type": "string" },
          "text_key": { "type": "string" },
          "conditions": { "type": "array", "items": { "type": "object" } },
          "actions": { "type": "array", "items": { "type": "object" } },
          "choices": { "type": "array", "items": { "type": "object" } },
          "next": { "type": "string" }
        }
      }
    }
  }
}
