{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dqse://schemas/quest",
  "title": "DQSE Quest Definition",
  "type": "object",
  "required": ["schema", "id", "type"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "ResourceLocation ID, e.g. 'mymod:first_mission'"
    },
    "type": { "type": "string", "const": "quest" },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title_key": { "type": "string" },
        "description_key": { "type": "string" },
        "category": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" }
      }
    },
    "logic": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "visibility": { "type": "object" },
        "steps": { "type": "object" },
        "completion_policy": { "type": "string", "enum": ["all_steps", "any_step"] },
        "repeatable": { "type": "boolean" },
        "sync_scope": { "type": "string", "enum": ["player"] }
      }
    },
    "rewards": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
