{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dqse://schemas/theme",
  "title": "DQSE Theme Definition",
  "type": "object",
  "required": [
    "schema",
    "layout",
    "frame_texture",
    "background_texture",
    "show_page_numbers",
    "show_close_button",
    "screen_width",
    "screen_height",
    "display_area",
    "title_area",
    "title_alignment",
    "text_area",
    "choice_area"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"type": "integer", "const": 1},
    "layout": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "description": "Theme layout ID, e.g. 'dialog_quest_and_story_engine:holopad'"
    },
    "frame_texture": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
    "background_texture": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
    "show_page_numbers": {"type": "boolean"},
    "show_close_button": {"type": "boolean"},
    "screen_width": {"type": "integer", "minimum": 1},
    "screen_height": {"type": "integer", "minimum": 1},
    "display_area": {"$ref": "#/definitions/area"},
    "title_area": {"$ref": "#/definitions/area"},
    "title_alignment": {"type": "string", "enum": ["left", "center", "right"]},
    "text_area": {"$ref": "#/definitions/area"},
    "choice_area": {"$ref": "#/definitions/area"}
  },
  "definitions": {
    "area": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    }
  }
}
